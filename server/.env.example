# Postgres connection string.
# Local dev example:   postgres://mafia:mafia@localhost:5432/mafia_world
# Supabase example:    postgres://postgres:[password]@[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# Long random secret used to sign JWT session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=4000

# development | production | test
NODE_ENV=development

# Frontend origin(s) allowed to call this API (CORS). One origin for local
# dev; in production use a comma-separated list (no spaces needed, they're
# trimmed) so the Vercel-assigned domain keeps working alongside a custom
# domain once you buy one, e.g.:
#   CORS_ORIGIN=https://mafia-world.vercel.app,https://mafiaworld.com
CORS_ORIGIN=http://localhost:3000

# Secret required to call the protected POST /internal/tick endpoint (added in a later phase).
# Generate the same way as JWT_SECRET.
TICK_SECRET=
